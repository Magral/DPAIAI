<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".activities.MainActivity">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"
        android:gravity="center_vertical">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/status_button"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:paddingLeft="10pt"
        android:paddingTop="5pt"
        android:paddingRight="10pt"
        android:paddingBottom="5pt"
        android:textAllCaps="false"
        android:textSize="24sp"
        tools:text="@string/vpn_connect" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/status_button"
        android:layout_marginTop="8dp"
        android:layout_centerHorizontal="true"
        tools:text="@string/vpn_disconnected" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/proxy_address"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/status_text"
        android:layout_centerHorizontal="true"
        tools:text="127.0.0.1:1080" />

    <TextView
        android:id="@+id/targets_summary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_below="@id/proxy_address" android:layout_margin="20dp"
        android:gravity="center" android:textSize="18sp" android:text="Instagram + YouTube" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/youtube_problem" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_below="@id/targets_summary" android:layout_marginHorizontal="20dp" android:textAllCaps="false" android:text="YouTube не работает" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/instagram_problem" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_below="@id/youtube_problem" android:layout_marginHorizontal="20dp" android:textAllCaps="false" android:text="Instagram не работает" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/service_tuning_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/instagram_problem"
        android:layout_marginHorizontal="20dp"
        android:textAllCaps="false"
        android:text="Подбор, база и диагностика" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/mobile_catalog_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/service_tuning_button"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:textSize="14sp" />
    </RelativeLayout>
</ScrollView>
