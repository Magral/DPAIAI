{
  "manifest_version": 3,
  "name": "DPI Pilot — только YouTube",
  "version": "0.1.0",
  "description": "Локальный обход DPI только для YouTube. Остальные сайты используют обычное соединение. Требуется DPI Pilot для Windows.",
  "key": "",
  "permissions": [
    "proxy",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "120"
}
